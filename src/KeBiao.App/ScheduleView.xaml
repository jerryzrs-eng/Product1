<UserControl x:Class="KeBiao.App.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KeBiao.App"
             FontFamily="{StaticResource UiFont}"
             TextOptions.TextFormattingMode="Ideal"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <local:ProgressToStarConverter x:Key="Star" />
        <local:BoolToVisibilityConverter x:Key="Vis" />
        <local:BoolToVisibilityConverter x:Key="NotVis" Invert="True" />

        <DataTemplate x:Key="RowTemplate" DataType="{x:Type local:LessonRow}">
            <Grid x:Name="root" Margin="0,1" Background="Transparent">
                <!-- 底色 + 进度 -->
                <Border x:Name="bg" CornerRadius="14" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" />
                <Grid x:Name="progress" Visibility="Collapsed" Margin="1" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding Progress, Converter={StaticResource Star}}" />
                        <ColumnDefinition Width="{Binding Progress, Converter={StaticResource Star}, ConverterParameter=rest}" />
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="13,0,0,13" Background="{StaticResource AccentProgress}" />
                </Grid>
                <Border x:Name="bar" Width="4" CornerRadius="2" HorizontalAlignment="Left" Margin="0,12" Background="Transparent" />
                <Border x:Name="drop" CornerRadius="14" BorderThickness="2" BorderBrush="{StaticResource Accent}" Visibility="Collapsed" />

                <Grid x:Name="content" Margin="14,9,10,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="numCol" Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="num" Text="{Binding TagText}" FontSize="13" FontWeight="SemiBold" LineHeight="14"
                               LineStackingStrategy="BlockLineHeight"
                               Foreground="{StaticResource InkMuted}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="name" Text="{Binding Name}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="time" Text="{Binding TimeText}" FontSize="13.5" Margin="0,1,0,0"
                                   Foreground="{StaticResource InkSoft}" />
                    </StackPanel>
                    <Border x:Name="badge" Grid.Column="2" Visibility="Collapsed" VerticalAlignment="Center"
                            CornerRadius="11" Padding="10,3" Background="White" BorderBrush="{StaticResource WarnEdge}" BorderThickness="1">
                        <TextBlock x:Name="badgeText" Text="即将开始" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource WarnInk}" />
                    </Border>
                    <TextBlock x:Name="grip" Grid.Column="2" Visibility="Collapsed" Text="&#xE700;" FontFamily="{StaticResource IconFont}"
                               FontSize="18" Foreground="{StaticResource InkMuted}" VerticalAlignment="Center" Margin="8,0,4,0" />
                </Grid>
                <Rectangle x:Name="rule" Height="1" Fill="{StaticResource Hairline}" VerticalAlignment="Bottom" Margin="48,0,8,-1" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Past">
                    <Setter TargetName="content" Property="Opacity" Value="0.42" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TagTwoLines}" Value="True">
                    <Setter TargetName="num" Property="FontSize" Value="11" />
                    <Setter TargetName="num" Property="LineHeight" Value="12.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Current">
                    <Setter TargetName="badge" Property="Visibility" Value="Visible" />
                    <Setter TargetName="badge" Property="BorderBrush" Value="{StaticResource AccentProgress}" />
                    <Setter TargetName="badgeText" Property="Text" Value="当前课程" />
                    <Setter TargetName="badgeText" Property="Foreground" Value="{StaticResource AccentInk}" />
                    <Setter TargetName="bg" Property="Background" Value="{StaticResource AccentFill}" />
                    <Setter TargetName="progress" Property="Visibility" Value="Visible" />
                    <Setter TargetName="bar" Property="Background" Value="{StaticResource Accent}" />
                    <Setter TargetName="name" Property="Foreground" Value="{StaticResource AccentInk}" />
                    <Setter TargetName="num" Property="Foreground" Value="{StaticResource AccentInk}" />
                    <Setter TargetName="rule" Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Soon">
                    <Setter TargetName="bg" Property="Background" Value="{StaticResource WarnFill}" />
                    <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource WarnEdge}" />
                    <Setter TargetName="bar" Property="Background" Value="{StaticResource Warn}" />
                    <Setter TargetName="name" Property="Foreground" Value="{StaticResource WarnInk}" />
                    <Setter TargetName="num" Property="Foreground" Value="{StaticResource WarnInk}" />
                    <Setter TargetName="badge" Property="Visibility" Value="Visible" />
                    <Setter TargetName="rule" Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Message">
                    <Setter TargetName="num" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="numCol" Property="Width" Value="0" />
                    <Setter TargetName="time" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="name" Property="Foreground" Value="{StaticResource InkSoft}" />
                    <Setter TargetName="name" Property="FontWeight" Value="Normal" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Large}" Value="True">
                    <Setter TargetName="name" Property="FontSize" Value="26" />
                    <Setter TargetName="time" Property="FontSize" Value="15" />
                    <Setter TargetName="num" Property="FontSize" Value="14" />
                    <Setter TargetName="numCol" Property="Width" Value="38" />
                    <Setter TargetName="badgeText" Property="FontSize" Value="13" />
                    <Setter TargetName="content" Property="Margin" Value="16,11,10,11" />
                    <Setter TargetName="rule" Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding State}" Value="Message" />
                        <Condition Binding="{Binding Large}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="name" Property="FontSize" Value="20" />
                    <Setter TargetName="numCol" Property="Width" Value="0" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding TagTwoLines}" Value="True" />
                        <Condition Binding="{Binding Large}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="num" Property="FontSize" Value="12" />
                    <Setter TargetName="num" Property="LineHeight" Value="14" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Editing}" Value="True">
                    <Setter TargetName="grip" Property="Visibility" Value="Visible" />
                    <Setter TargetName="badge" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="root" Property="Cursor" Value="SizeAll" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                    <Setter TargetName="root" Property="Opacity" Value="0.35" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter TargetName="drop" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
        </Grid.LayoutTransform>

        <Border x:Name="Card" Margin="14,10,14,18" CornerRadius="24" Background="{StaticResource CardFill}"
                BorderBrush="{StaticResource CardEdge}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.22" Color="#0B1A3A" />
            </Border.Effect>
            <Grid>
                <!-- 展开 -->
                <DockPanel Width="320" Visibility="{Binding Expanded, Converter={StaticResource Vis}}" Margin="0,0,0,10">
                    <Grid DockPanel.Dock="Top" Margin="22,18,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ClassName}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Ink}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DateText}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"
                                       Foreground="{StaticResource InkSoft}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                                    Visibility="{Binding EditMode, Converter={StaticResource NotVis}}">
                            <Button x:Name="LockButton" Style="{StaticResource IconButton}" />
                            <Button x:Name="CollapseButton" Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="折叠" />
                        </StackPanel>
                        <Button x:Name="DoneButton" Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource PrimaryButton}"
                                MinHeight="40" MinWidth="72" Content="完成"
                                Visibility="{Binding EditMode, Converter={StaticResource Vis}}" />
                    </Grid>
                    <Rectangle DockPanel.Dock="Top" Height="1" Fill="{StaticResource Hairline}" Margin="22,0,22,6" />
                    <TextBlock DockPanel.Dock="Top" Text="拖动一节课到另一节上，两节互换" FontSize="13" Margin="22,2,22,6"
                               Foreground="{StaticResource AccentInk}"
                               Visibility="{Binding EditMode, Converter={StaticResource Vis}}" />
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding FooterText}" FontSize="14" Margin="22,8,22,2"
                               Foreground="{StaticResource InkSoft}" TextWrapping="Wrap"
                               Visibility="{Binding HasFooterText, Converter={StaticResource Vis}}" />
                    <Grid>
                        <TextBlock Text="{Binding EmptyText}" FontSize="20" Foreground="{StaticResource InkSoft}" TextAlignment="Center"
                                   HorizontalAlignment="Center" Margin="20,36,20,30" LineHeight="32"
                                   Visibility="{Binding HasEmptyText, Converter={StaticResource Vis}}" />
                        <ScrollViewer x:Name="RowsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly" Padding="10,0">
                            <ItemsControl x:Name="RowsList" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" />
                        </ScrollViewer>
                    </Grid>
                </DockPanel>

                <!-- 折叠 -->
                <Grid Width="320" Visibility="{Binding Collapsed, Converter={StaticResource Vis}}" Margin="10,10,6,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl ItemsSource="{Binding CompactRows}" ItemTemplate="{StaticResource RowTemplate}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0">
                        <Button x:Name="LockButton2" Style="{StaticResource IconButton}" />
                        <Button x:Name="ExpandButton" Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="展开" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <Border Margin="14,10,14,18" CornerRadius="24" BorderThickness="2" BorderBrush="{StaticResource Accent}" IsHitTestVisible="False"
                Visibility="{Binding EditMode, Converter={StaticResource Vis}}" />
    </Grid>
</UserControl>
