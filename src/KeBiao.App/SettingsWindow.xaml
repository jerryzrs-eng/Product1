<Window x:Class="KeBiao.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="课表 设置" Width="1060" Height="720" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}"
        Background="{StaticResource SurfaceAlt}" UseLayoutRounding="True"
        Stylus.IsPressAndHoldEnabled="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="14,22,10,14" x:Name="Nav">
            <RadioButton x:Name="NavBasic" Style="{StaticResource NavItem}" Content="基本" GroupName="nav" />
            <RadioButton x:Name="NavTable" Style="{StaticResource NavItem}" Content="课表与作息" GroupName="nav" />
            <RadioButton x:Name="NavDates" Style="{StaticResource NavItem}" Content="日期调整" GroupName="nav" />
            <RadioButton x:Name="NavImport" Style="{StaticResource NavItem}" Content="导入导出" GroupName="nav" />
            <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" Content="历史版本" GroupName="nav" />
        </StackPanel>
        <Border Grid.Column="1" Background="{StaticResource Surface}" CornerRadius="16,0,0,0" BorderBrush="#0F000000" BorderThickness="1,1,0,0">
            <ContentControl x:Name="PageHost" Margin="36,28,36,24" />
        </Border>
    </Grid>
</Window>
